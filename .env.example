NEXT_PUBLIC_PARTICLE_CLIENT_KEY=crwCy0oYSHQzQnY6WNQRwGz9UO6bEI4e5l3z4yl1
NEXT_PUBLIC_PARTICLE_APP_ID=12039a72-9e05-4f0a-a949-57dd2ec46db7

# --- App ---
NEXT_PUBLIC_APP_NAME=OneShot
